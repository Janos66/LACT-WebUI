[Unit]
Description=LACT GPU Control Web UI
Documentation=https://github.com/Janos66/LACT-WebUI
# After=multi-user.target is required: upstream lactd.service itself starts
# After=multi-user.target. Without it, WantedBy=multi-user.target + After=lactd
# creates a start-ordering cycle (target -> webui -> daemon -> target) and systemd
# silently deletes the webui start job at boot, leaving the UI down after every
# reboot. This unit must therefore start after the target completes.
After=network-online.target lactd.service multi-user.target
Wants=lactd.service

[Service]
Type=simple
ExecStart=/usr/bin/lact-webui
Restart=on-failure
RestartSec=2
# The web UI talks to /run/lactd.sock; root is required to pass the daemon's polkit checks.
# It never executes user-supplied commands: every request is a typed message to lactd.
User=root
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/run /var/log
# DevicePolicy is intentionally left at the default (no device filtering): nvme smart-log needs
# the NVMe device nodes; see the comment above.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
